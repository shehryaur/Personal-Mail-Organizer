{
  "manifest_version": 3,
  "name": "Jobs Board for Gmail",
  "version": "2.0.0",
  "description": "Adds a Jobs Board to Gmail's sidebar: every job application as one row, with deadlines and stages from your own tracker sheet.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["board.html", "assets/*"],
      "matches": ["https://mail.google.com/*"]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Jobs Board settings"
  }
}
