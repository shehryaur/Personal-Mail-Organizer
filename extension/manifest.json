{
  "manifest_version": 3,
  "name": "Job Application Tracker for Gmail",
  "version": "1.0.0",
  "description": "Operational job application triage banner and deadline tracker directly inside Gmail.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Job Tracker Dashboard"
  }
}
